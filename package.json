{
  "name": "playroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" index.html README.md",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\" index.html README.md",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run format:check && npm run build"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  }
}
